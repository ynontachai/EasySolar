# EasySolar reads DATABASE_URL first, then POSTGRES_URL or SUPABASE_POSTGRES_URL
# from the Vercel/Supabase integration.
# On Vercel, use the Supabase transaction pooler URI with sslmode=require.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/easysolar
DATABASE_POOL_MAX=1

# Private S3-compatible object storage. Leave S3_ENDPOINT blank for AWS S3.
# For Supabase Storage S3, use its direct storage endpoint and set S3_FORCE_PATH_STYLE=true.
S3_BUCKET=easysolar-private
S3_REGION=ap-southeast-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Supabase Auth. Publishable/anon keys are browser-safe only when RLS is enforced.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may expose NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
# Server-only. Required to send Admin invitation emails. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Scanner callback remains machine-to-machine and must use a separate secret.
EASYSOLAR_SCANNER_TOKEN=replace-with-a-separate-scanner-secret

# external in production. trusted-dev is accepted only outside production.
FILE_SCAN_MODE=external
APP_ENVIRONMENT=development

NEXT_PUBLIC_SITE_URL=http://localhost:3000
